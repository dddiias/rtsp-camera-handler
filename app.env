# Основные настройки
UPSTREAM_URL=https://snowops-anpr-service.onrender.com/api/v1/anpr/events
PLATE_CAMERA_ID=camera-001

# Merge timing (короткие окна, чтобы не матчить чужие машины)
MERGE_WINDOW_SECONDS=20
MERGE_TTL_SECONDS=50
MERGE_MAX_EVENT_AGE_SECONDS=30.0
# Часовой пояс локального времени (Астана = UTC+5 по текущему времени)
LOCAL_TZ_OFFSET_HOURS=5
# Требовать обязательный матч снега, иначе не шлём событие
MERGE_REQUIRE_SNOW_MATCH=false

# ============================================
# RTSP Stream Processor (основной режим работы)
# ============================================
ENABLE_STREAM_PROCESSOR=true

# RTSP потоки камер
PLATE_CAMERA_RTSP=rtsp://admin:Armat456321@178.22.170.254:554/streaming/channels/101
SNOW_CAMERA_RTSP=rtsp://admin:Armat456321@178.22.170.254:555/streaming/channels/101

# Настройки детекции пересечения линии для номерной камеры
# PLATE_LINE_Y_POSITION: позиция линии (0.0-1.0, где 0.0 = верх кадра, 1.0 = низ кадра)
PLATE_LINE_Y_POSITION=0.65
# PLATE_LINE_DIRECTION: направление пересечения ("down" = сверху вниз, "up" = снизу вверх)
PLATE_LINE_DIRECTION=down

# Настройки детекции пересечения линии для снеговой камеры
# SNOW_LINE_Y_POSITION: позиция линии (0.0-1.0, где 0.0 = верх кадра, 1.0 = низ кадра)
SNOW_LINE_Y_POSITION=0.82
# SNOW_LINE_DIRECTION: направление пересечения ("down" = сверху вниз, "up" = снизу вверх)
SNOW_LINE_DIRECTION=down
# Минимальная уверенность детекции машин (0.0-1.0)
STREAM_MIN_CONFIDENCE=0.5
# Минимальная площадь bbox для детекции (в пикселях)
STREAM_MIN_BBOX_AREA=10000
# Отображение потоков в окне (для отладки и настройки линии)
SHOW_STREAM_WINDOW=true

# Настройки трекинга
TRACK_MAX_AGE=30
TRACK_MIN_HITS=3
TRACK_IOU_THRESHOLD=0.3

# Окно дедупликации (секунды)
STREAM_DEDUP_WINDOW_SECONDS=5.0

# YOLO модель для детекции машин
YOLO_MODEL_PATH=yolov8n.pt

# ============================================
# Старая логика (отключена по умолчанию)
# ============================================
# Старый HTTP endpoint для получения событий от камеры
ENABLE_HIKVISION_API=false

# Старый snow worker (используется только для обратной совместимости)
ENABLE_SNOW_WORKER=false
SNOW_VIDEO_SOURCE_URL="rtsp://admin:Armat456321@194.26.239.249:555/Streaming/Channels/101"
SNOW_CAMERA_ID="camera-snow"
SNOW_CAPTURE_DELAY_SECONDS=4.0
SNOW_YOLO_MODEL_PATH=yolov8n.pt
SNAPSHOT_BASE_DIR="snapshots"
SNOW_CENTER_ZONE_START_X=0.15
SNOW_CENTER_ZONE_END_X=0.85
SNOW_CENTER_ZONE_START_Y=0.0
SNOW_CENTER_ZONE_END_Y=1.0
SNOW_CENTER_LINE_X=0.5
SNOW_MIN_DIRECTION_DELTA=2
SNOW_STATIONARY_TIMEOUT_SECONDS=10.0
SNOW_MISS_RESET_THRESHOLD=6
SNOW_SHOW_WINDOW=false

# Whitelist check before Gemini (optional)
# URL must accept ?plate=... and return 2xx if vehicle exists
MERGER_VEHICLE_CHECK_URL=https://snowops-anpr-service.onrender.com/internal/vehicles/check
# Bearer token for whitelist check (leave empty if not needed)
MERGER_VEHICLE_CHECK_TOKEN=snowops-internal-secret

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
